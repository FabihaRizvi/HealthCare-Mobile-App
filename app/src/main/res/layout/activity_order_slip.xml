<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/slipRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp"
    android:background="@drawable/background_gradient"
    android:elevation="8dp">

    <TextView
        android:id="@+id/tvSlipHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/order_slip"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:gravity="center"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/customerDetailsLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="@android:color/transparent"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/tvSlipHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvSlipName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/name_sam"
            android:textSize="16sp"
            android:textColor="@color/black"/>

        <TextView
            android:id="@+id/tvSlipContact"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/contact_0300_1234567"
            android:textSize="16sp"
            android:textColor="@color/black"/>

        <TextView
            android:id="@+id/tvSlipAddress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/address_texas_america"
            android:textSize="16sp"
            android:textColor="@color/black"/>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSlipMedicines"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@android:color/transparent"
        android:padding="6dp"
        app:layout_constraintTop_toBottomOf="@id/customerDetailsLayout"
        app:layout_constraintBottom_toTopOf="@id/tvSlipTotal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/tvSlipTotal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:text="@string/total_rs_1500_incl_delivery"
        android:textStyle="bold"
        android:textSize="18sp"
        android:textColor="@color/black"
        android:padding="10dp"
        app:layout_constraintTop_toBottomOf="@id/rvSlipMedicines"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvSlipDeliveryTime"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/delivery_within_24_hours"
        android:textSize="14sp"
        android:textColor="@color/secondHeadingGrey"
        android:gravity="end"
        android:padding="6dp"
        app:layout_constraintTop_toBottomOf="@id/tvSlipTotal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <Button
        android:id="@+id/btnDownloadSlip"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/download_slip"
        android:textAllCaps="false"
        android:backgroundTint="@color/purple"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/tvSlipDeliveryTime"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
